{
  "name": "birthday-files",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "party": "node scripts/lib/preflight.mjs 3000 && next build && next start -H 0.0.0.0 -p 3000",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "narration:render": "tsx --conditions=react-server scripts/render-narration.ts",
    "host:check": "tsx --conditions=react-server scripts/host-check.ts",
    "rehearsal": "node scripts/rehearsal.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
