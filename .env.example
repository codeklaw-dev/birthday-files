# Copy to .env.local (never commit it). Everything is optional: with no keys the show
# runs on pre-recorded clips plus offline mocks. See docs/AI_PROVIDERS.md.

# Key the host types into /admin. Defaults to "mez-host" when unset — set your own.
HOST_KEY=

# Optional: the public origin phones should open (used for the QR code).
NEXT_PUBLIC_BASE_URL=

# ---- AI host: cloud providers (server-side only; never NEXT_PUBLIC_) ----
# Gemini — Google AI Studio key, free tier, no card. Speech (EN + Bangla), commentary, listening.
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts   # run `npm run host:check` to see valid IDs
# GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_STYLE=      # e.g. "Say cheerfully:" — test first: some TTS models read it aloud

# Groq — free tier, no card. Fast Whisper speech-to-text and a backup LLM.
GROQ_API_KEY=
# GROQ_LLM_MODEL=qwen/qwen3.8-27b   # or openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Cloudflare Workers AI — free 10k neurons/day, no card. Backup LLM + Whisper.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Azure Speech — best Bangladeshi voices. NEEDS APPROVAL: Azure sign-up requires a card.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_VOICE_BN=bn-BD-PradeepNeural
# AZURE_VOICE_EN=en-GB-RyanNeural

# Order in which providers are tried (unconfigured ones are skipped; the mock is always last).
# HOST_TTS_CHAIN=gemini,azure
# HOST_LLM_CHAIN=gemini,groq,cloudflare
# HOST_STT_CHAIN=groq,gemini,cloudflare
# HOST_TTS_TIMEOUT_MS=9000
# HOST_ALLOW_MOCK_AUDIO=1   # dev only: let the beeping mock stand in for live speech

# Room state is snapshotted to .data/room.json so a restart doesn't lose the party.
# ROOM_PERSIST=off
