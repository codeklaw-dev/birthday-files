# Copy to .env.local. Nothing here is required for the mock prototype.

# Key the host types into /admin. Defaults to "mez-host" when unset — set a real one before any shared use.
HOST_KEY=

# Optional: the public origin phones should open (used for the QR code).
# Leave empty on a home network; the display falls back to the laptop's LAN address.
NEXT_PUBLIC_BASE_URL=

# --- Not used yet (Milestone 2+). Do not fill in until those adapters exist. ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Casper: variable names to be decided once the real API contract is shared.
